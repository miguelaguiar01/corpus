{
  "name": "corpus",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "dev": "npm run dev --workspace apps/web --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.20.5",
    "cldr-core": "48.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
