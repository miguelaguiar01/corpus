# Corpus web app environment. Next.js reads apps/web/.env (this
# directory), not the repository root. Copy this file to .env and edit.

# Instance invite secret (spec §10): required. Anyone presenting it plus a
# display name gets a session; the first user ever created becomes a
# maintainer.
CORPUS_INVITE_SECRET=change-me

# SQLite database file. Default: data/corpus.db under apps/web, wherever
# you start the app from. The container sets /data/corpus.db (a volume).
# CORPUS_DB_PATH=data/corpus.db

# Migrations folder override; normally found next to the app. Leave unset.
# CORPUS_MIGRATIONS_DIR=drizzle
