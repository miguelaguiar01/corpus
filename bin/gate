#!/usr/bin/env bash
# bin/gate — the single QA entry point (AGENTS.md, spec §14).
# Must pass before opening any PR; CI re-runs it on every PR.
#
# Steps: typecheck + lint + format check + full test suite + corpus check
# on this repo's own catalog. Any step failing fails the gate.
set -euo pipefail
cd "$(dirname "$0")/.."

step() {
  echo
  echo "=== gate: $1 ==="
}

step "typecheck"
npm run typecheck

step "lint"
npm run lint

step "format"
npm run format

step "build the CLI package"
npm run build -w packages/cli

step "tests"
npm test

step "corpus check (self catalog)"
# The repo's own chrome must come from the catalog (§12): the real
# `corpus check` on this repo, configured in corpus.config.ts, run from
# the binary built above so the gate exercises what ships.
node packages/cli/dist/bin.js check

echo
echo "=== gate: PASS ==="
