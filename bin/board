#!/usr/bin/env bash
# bin/board — add an issue to the Corpus project board and set its lane.
#
# Usage: bin/board <issue#> <backlog|ready|in-progress|blocked|done>
#
# IDs come from AGENTS.md ("IDs for bin/board", project #4, owner
# miguelaguiar01). Idempotent: an issue already on the board just gets its
# lane updated. Two GraphQL mutations a move, the issue's node id from
# REST, so a run of moves does not spend the hourly GraphQL budget a
# listing of the whole board does (#1054).
set -euo pipefail

OWNER=miguelaguiar01
PROJECT_ID=PVT_kwHOAYLnWs4BiZ1K
STATUS_FIELD_ID=PVTSSF_lAHOAYLnWs4BiZ1KzhhSBm0

usage() {
  echo "usage: bin/board <issue#> <backlog|ready|in-progress|blocked|done>" >&2
  exit 1
}

[ $# -eq 2 ] || usage
case "$1" in
  ''|*[!0-9]*) usage ;;
esac

case "$2" in
  backlog)     OPTION_ID=15972a3d ;;
  ready)       OPTION_ID=aefe58df ;;
  in-progress) OPTION_ID=fcdf6852 ;;
  blocked)     OPTION_ID=ee89bafc ;;
  done)        OPTION_ID=a6ea2847 ;;
  *) usage ;;
esac

ISSUE=$1

# A spent budget says so, rather than whatever error it surfaces as.
call() {
  local out
  if ! out=$("$@" 2>&1); then
    if grep -qiE 'rate.?limit|RATE_LIMITED|secondary' <<<"$out"; then
      local reset
      reset=$(gh api rate_limit --jq '.resources.graphql.reset | todate' 2>/dev/null || echo "within the hour")
      echo "bin/board: GitHub's rate limit is spent (#$ISSUE not moved); the GraphQL budget resets at $reset" >&2
      exit 2
    fi
    echo "$out" >&2
    exit 1
  fi
  printf '%s' "$out"
}

NODE_ID=$(call gh api "repos/$OWNER/corpus/issues/$ISSUE" --jq .node_id)

ITEM_ID=$(call gh api graphql \
  -f query='mutation($project: ID!, $content: ID!) {
    addProjectV2ItemById(input: { projectId: $project, contentId: $content }) { item { id } }
  }' \
  -f project="$PROJECT_ID" -f content="$NODE_ID" \
  --jq .data.addProjectV2ItemById.item.id)

call gh api graphql \
  -f query='mutation($project: ID!, $item: ID!, $field: ID!, $option: String!) {
    updateProjectV2ItemFieldValue(input: {
      projectId: $project, itemId: $item, fieldId: $field,
      value: { singleSelectOptionId: $option }
    }) { projectV2Item { id } }
  }' \
  -f project="$PROJECT_ID" -f item="$ITEM_ID" -f field="$STATUS_FIELD_ID" \
  -f option="$OPTION_ID" >/dev/null

echo "#$ISSUE -> $2"
