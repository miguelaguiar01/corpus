#!/usr/bin/env bash
# A release tag must name the version in both published packages'
# manifests, and the changelog must have a section for it. Run by the
# release workflow; run it yourself before tagging.
set -euo pipefail
cd "$(dirname "$0")/.."
TAG="${1:-}"
[ -n "$TAG" ] || { echo "usage: bin/release-check v<version>" >&2; exit 2; }
VERSION="${TAG#v}"
PACKAGES="packages/cli packages/workbench"
for dir in $PACKAGES; do
  PKG="$(node -p "require('./$dir/package.json').version")"
  [ "$VERSION" = "$PKG" ] || { echo "tag $TAG does not match $dir/package.json version $PKG" >&2; exit 1; }
done
bin/changelog-section "$VERSION" >/dev/null || { echo "CHANGELOG.md has no section for $VERSION" >&2; exit 1; }
grep -q '"corpus": "dist/bin.js"' packages/cli/package.json || { echo "the corpus bin entry is missing" >&2; exit 1; }
grep -q '"corpus-workbench": "bin/corpus-workbench.cjs"' packages/workbench/package.json || { echo "the corpus-workbench bin entry is missing" >&2; exit 1; }
for dir in $PACKAGES; do
  NAME="$(node -p "require('./$dir/package.json').name")"
  # A version already on the registry (the first one goes up by hand; a
  # re-run of a tag) is not published again, and npm refuses even a dry
  # run over it, so the manifest check is skipped for it.
  if npm view "${NAME}@${VERSION}" version >/dev/null 2>&1; then
    echo "release-check: ${NAME}@${VERSION} is already on the registry"
    continue
  fi
  # npm rewrites a manifest it dislikes at publish time (a bin path with
  # a leading ./ once lost the corpus binary); only a publish dry run
  # shows it. The workbench's prepack builds the web app.
  DRY="$(cd "$dir" && CORPUS_WORKBENCH_SKIP_WEB_BUILD="${CORPUS_WORKBENCH_SKIP_WEB_BUILD:-}" npm publish --dry-run --access public 2>&1)" || { echo "$DRY" >&2; exit 1; }
  if grep -q "auto-corrected" <<<"$DRY"; then
    echo "npm would rewrite $dir/package.json at publish time:" >&2
    grep "npm warn publish" <<<"$DRY" >&2
    exit 1
  fi
  echo "release-check: ${NAME}@${VERSION} publishes as written"
done
echo "release-check: $TAG matches both packages and the changelog"
