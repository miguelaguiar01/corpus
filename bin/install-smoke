#!/usr/bin/env bash
# The package a stranger installs (spec §16, M6): pack the CLI, install
# the tarball into a fresh repository with a small message catalog, and
# run the whole loop against the production image: init, push, pull at
# every state, and prove the repository is byte-identical. Nothing here
# reads the workspace's source; only the tarball and a booted container.
set -euo pipefail
cd "$(dirname "$0")/.."

export CORPUS_SMOKE_NAME="corpus-install-$$"
export CORPUS_SMOKE_PORT="${CORPUS_INSTALL_PORT:-3904}"
TMP="$(mktemp -d)"
cleanup() {
  docker rm -f "$CORPUS_SMOKE_NAME" >/dev/null 2>&1 || true
  docker volume rm "$CORPUS_SMOKE_NAME-data" >/dev/null 2>&1 || true
  rm -rf "$TMP"
}
trap cleanup EXIT

echo "=== install-smoke: pack the CLI ==="
( cd packages/cli && npm pack --pack-destination "$TMP" 2>&1 | tail -1 )
TARBALL="$(ls "$TMP"/*.tgz)"

bin/container-smoke --keep

echo "=== install-smoke: seed the client project inside the container ==="
TOKEN="$(openssl rand -hex 24)"
docker exec -e TOKEN="$TOKEN" "$CORPUS_SMOKE_NAME" node -e '
  const Database = require("/app/node_modules/better-sqlite3");
  const { createHash } = require("node:crypto");
  const db = new Database("/data/corpus.db");
  const hash = createHash("sha256").update(process.env.TOKEN).digest("hex");
  db.prepare("insert into projects (slug, name, source_language, languages, token_hash, created_at) values (?, ?, ?, ?, ?, ?)")
    .run("install-smoke", "Install smoke", "en", JSON.stringify(["en", "pt-PT"]), hash, Date.now());
  console.log("seeded project install-smoke");
'

echo "=== install-smoke: a fresh repository, the tarball installed ==="
CLIENT="$TMP/client"
mkdir -p "$CLIENT/src/i18n"
cat > "$CLIENT/src/i18n/en.json" <<'JSON'
{
  "greeting": "Hello {name}",
  "farewell": "Goodbye"
}
JSON
( cd "$CLIENT" && npm init -y >/dev/null && npm install --no-audit --no-fund "$TARBALL" 2>&1 | tail -1 )
[ ! -e "$CLIENT/node_modules/.bin/tsx" ] || { echo "the client got tsx; the bin must run on plain node" >&2; exit 1; }
head -1 "$CLIENT/node_modules/@corpus-tool/cli/dist/bin.js" | grep -q '^#!/usr/bin/env node$' || { echo "the bin's shebang is not plain node" >&2; exit 1; }

cd "$CLIENT"
export CORPUS_TOKEN="$TOKEN"
SERVER="http://127.0.0.1:$CORPUS_SMOKE_PORT"

echo "=== install-smoke: init ==="
npx corpus init --project install-smoke --source en --languages en,pt-PT \
  --messages "src/i18n/{lang}.json" --server "$SERVER"
grep -q '@corpus-tool/cli' corpus.config.ts

# What the repository looks like before Corpus touches it.
cp -r "$CLIENT" "$TMP/before" && rm -rf "$TMP/before/node_modules"
same_as_before() {
  diff -r --exclude=node_modules --exclude=package-lock.json "$TMP/before" "$CLIENT" \
    || { echo "pull changed the repository ($1)" >&2; exit 1; }
}

echo "=== install-smoke: push ==="
npx corpus push | tee "$TMP/push.log"
grep -q "2 added" "$TMP/push.log"

echo "=== install-smoke: pull at untranslated must reproduce the repository ==="
npx corpus pull --min-state untranslated
same_as_before "untranslated"

echo "=== install-smoke: pull at verified must write nothing ==="
npx corpus pull
same_as_before "verified"

echo "=== install-smoke: push again is a no-op diff ==="
npx corpus push | tee "$TMP/push2.log"
grep -q "0 added" "$TMP/push2.log"

echo "=== install-smoke: PASS ==="
