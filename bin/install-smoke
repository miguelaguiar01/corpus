#!/usr/bin/env bash
# The packages a stranger installs (spec §16, M6 and M8): pack the CLI
# and the workbench, install both tarballs into a fresh repository with
# a small message catalog, and run the whole loop twice: against
# `npx corpus workbench` with no Docker, then against the production
# image. Each loop is init, push, pull at every state, and proof that
# the repository is byte-identical. Nothing here reads the workspace's
# source; only the tarballs, the client's node_modules, and the servers.
set -euo pipefail
cd "$(dirname "$0")/.."

export CORPUS_SMOKE_NAME="corpus-install-$$"
export CORPUS_SMOKE_PORT="${CORPUS_INSTALL_PORT:-3904}"
WB_PORT="${CORPUS_INSTALL_WB_PORT:-3905}"
TMP="$(mktemp -d)"
WB_PGID=""
cleanup() {
  [ -z "$WB_PGID" ] || kill -TERM -- "-$WB_PGID" >/dev/null 2>&1 || true
  docker rm -f "$CORPUS_SMOKE_NAME" >/dev/null 2>&1 || true
  docker volume rm "$CORPUS_SMOKE_NAME-data" >/dev/null 2>&1 || true
  rm -rf "$TMP"
}
trap cleanup EXIT

echo "=== install-smoke: pack the CLI and the workbench ==="
( cd packages/cli && npm pack --pack-destination "$TMP" 2>&1 | tail -1 )
( cd packages/workbench && npm pack --pack-destination "$TMP" 2>&1 | tail -1 )

echo "=== install-smoke: a fresh repository, both tarballs installed ==="
CLIENT="$TMP/client"
mkdir -p "$CLIENT/src/i18n"
cat > "$CLIENT/src/i18n/en.json" <<'JSON'
{
  "greeting": "Hello {name}",
  "farewell": "Goodbye"
}
JSON
# A target catalogue the repository already keeps: pull rewrites it
# through the writer and must leave the same bytes.
cat > "$CLIENT/src/i18n/pt-PT.json" <<'JSON'
{
  "greeting": "Olá {name}"
}
JSON
( cd "$CLIENT" && npm init -y >/dev/null && printf 'node_modules\n' > .gitignore && npm install --no-audit --no-fund "$TMP"/*.tgz 2>&1 | tail -1 )
[ ! -e "$CLIENT/node_modules/.bin/tsx" ] || { echo "the client got tsx; the bin must run on plain node" >&2; exit 1; }
head -1 "$CLIENT/node_modules/@corpus-tool/cli/dist/bin.js" | grep -q '^#!/usr/bin/env node$' || { echo "the bin's shebang is not plain node" >&2; exit 1; }
[ ! -e "$CLIENT/node_modules/@corpus-tool/workbench/node_modules" ] || { echo "the workbench tarball carried a node_modules" >&2; exit 1; }

cd "$CLIENT"

# The declarations are checked on the instance's database: the client's
# own copy of the SQLite binding for the workbench, docker exec for the
# container.
DECL_JS='
  const Database = require(process.env.SQLITE_MODULE);
  const row = new Database(process.env.DB).prepare("select string_types, entity_types from projects where slug = ?").get("install-smoke");
  if (!row.string_types?.includes("tone") || !row.entity_types?.includes("Room")) {
    console.error("the push did not carry the declarations:", row); process.exit(1);
  }
  console.log("the instance holds the declarations");
'

same_as_before() {
  diff -r --exclude=node_modules --exclude=package-lock.json --exclude=.corpus "$TMP/before" "$CLIENT" \
    || { echo "pull changed the repository ($1)" >&2; exit 1; }
}

# The config: init once, with declarations as a real project has them
# (§5); later loops repoint the server. $1 server URL.
configure() {
  local server="$1"
  if [ ! -e corpus.config.ts ]; then
    echo "=== install-smoke: init ==="
    npx corpus init --project install-smoke --source en --languages en,pt-PT \
      --messages "src/i18n/{lang}.json" --server "$server"
    grep -q '@corpus-tool/cli' corpus.config.ts
    node -e '
      const fs = require("node:fs");
      const src = fs.readFileSync("corpus.config.ts", "utf8");
      const decl = `  stringTypes: { chrome: { tone: { type: "enum", description: "How the line reads.", values: ["plain", "urgent"] } } },\n  entityTypes: { room: { label: "Room" } },\n  sources:`;
      if (!src.includes("  sources:")) throw new Error("no sources in the generated config");
      fs.writeFileSync("corpus.config.ts", src.replace("  sources:", decl));
    '
  else
    sed -i "s|server: \"[^\"]*\"|server: \"$server\"|" corpus.config.ts
    grep -q "$server" corpus.config.ts
  fi
}

# The loop against one instance: snapshot the repository, push, check
# the declarations, pull at both states, push again. The token is
# whatever the CLI finds (CORPUS_TOKEN, or .corpus/token). $1 the
# command that checks the declarations on that instance's database.
loop() {
  local check="$1"
  rm -rf "$TMP/before"; cp -r "$CLIENT" "$TMP/before"; rm -rf "$TMP/before/node_modules" "$TMP/before/.corpus"

  echo "=== install-smoke: push ==="
  npx corpus push | tee "$TMP/push.log"
  grep -q "2 added" "$TMP/push.log"
  eval "$check"

  echo "=== install-smoke: pull at untranslated must reproduce the repository ==="
  npx corpus pull --min-state untranslated
  same_as_before "untranslated"

  echo "=== install-smoke: pull at verified must write nothing ==="
  npx corpus pull
  same_as_before "verified"

  echo "=== install-smoke: push again is a no-op diff ==="
  npx corpus push | tee "$TMP/push2.log"
  grep -q "0 added" "$TMP/push2.log"
}

echo "=== install-smoke: corpus workbench, no Docker ==="
# The config exists before the workbench starts, so the start creates
# the project it declares and writes .corpus/token (§2); no token is
# pasted anywhere on this path.
configure "http://localhost:$WB_PORT"
unset CORPUS_TOKEN
setsid npx corpus workbench --port "$WB_PORT" > "$TMP/workbench.log" 2>&1 < /dev/null &
WB_PGID="$!"
for _ in $(seq 1 120); do
  grep -q "written to .corpus/token" "$TMP/workbench.log" 2>/dev/null && break
  kill -0 "$WB_PGID" 2>/dev/null || { cat "$TMP/workbench.log" >&2; echo "corpus workbench exited" >&2; exit 1; }
  sleep 0.5
done
curl -sf "http://localhost:$WB_PORT/api/health" >/dev/null || { cat "$TMP/workbench.log" >&2; echo "corpus workbench did not answer" >&2; exit 1; }
grep -q "is running at http://localhost:$WB_PORT" "$TMP/workbench.log"
grep -q "written to .corpus/token (project install-smoke created)" "$TMP/workbench.log" || { cat "$TMP/workbench.log" >&2; echo "the workbench did not provision the project" >&2; exit 1; }
[ -f .corpus/secret ] && [ -f .corpus/corpus.db ] && [ -f .corpus/token ] || { echo ".corpus/ lacks the secret, the database or the token" >&2; exit 1; }
[ "$(stat -c %a .corpus/token)" = "600" ] || { echo ".corpus/token is not owner-only" >&2; exit 1; }
grep -qx '.corpus/' .gitignore
loop "SQLITE_MODULE='$CLIENT/node_modules/better-sqlite3' DB='$CLIENT/.corpus/corpus.db' node -e \"\$DECL_JS\""
kill -TERM -- "-$WB_PGID"; WB_PGID=""
for _ in $(seq 1 40); do curl -sf "http://localhost:$WB_PORT/api/health" >/dev/null 2>&1 || break; sleep 0.5; done
curl -sf "http://localhost:$WB_PORT/api/health" >/dev/null 2>&1 && { echo "the workbench kept running after the command was stopped" >&2; exit 1; }
echo "=== install-smoke: the workbench stopped with the command ==="

echo "=== install-smoke: the container ==="
( cd "$OLDPWD" && bin/container-smoke --keep )
configure "http://127.0.0.1:$CORPUS_SMOKE_PORT"
# The container is another instance: its secret comes from the
# environment, which wins over .corpus/secret, and the token from the
# command's last line (§3).
rm -f .corpus/token
CORPUS_TOKEN="$(CORPUS_INVITE_SECRET=smoke-only-not-a-secret npx corpus project create --name "Install smoke" | tail -1)"
export CORPUS_TOKEN
[ -n "$CORPUS_TOKEN" ] || { echo "no token from corpus project create" >&2; exit 1; }
loop "docker exec -e SQLITE_MODULE=/app/node_modules/better-sqlite3 -e DB=/data/corpus.db '$CORPUS_SMOKE_NAME' node -e \"\$DECL_JS\""

echo "=== install-smoke: PASS ==="
