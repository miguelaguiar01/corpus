#!/usr/bin/env bash
# Corpus translates Corpus (spec §12, §15): boot the production image,
# seed the repo's own project, push the chrome catalog with the real CLI,
# pull it back at every state, and prove the working tree is unchanged,
# the committed Portuguese catalogue included: pull rewrites an existing
# target catalogue through the writer and must land on the same bytes.
# The standard adapter path can never silently rot: this breaks first.
set -euo pipefail
cd "$(dirname "$0")/.."

export CORPUS_SMOKE_NAME="corpus-dogfood-$$"
export CORPUS_SMOKE_PORT="${CORPUS_DOGFOOD_PORT:-3901}"
cleanup() {
  docker rm -f "$CORPUS_SMOKE_NAME" >/dev/null 2>&1 || true
  docker volume rm "$CORPUS_SMOKE_NAME-data" >/dev/null 2>&1 || true
}
trap cleanup EXIT

bin/container-smoke --keep

export CORPUS_SERVER="http://127.0.0.1:$CORPUS_SMOKE_PORT"
# The shipped binary, not the source: the dogfood proves the built CLI.
npm run build -w packages/cli >/dev/null
corpus() { node packages/cli/dist/bin.js "$@"; }

echo "=== dogfood: create the corpus-chrome project with the instance secret ==="
# The container's secret (bin/container-smoke); the token is the last
# line of stdout, as the CLI promises (§3).
CORPUS_TOKEN="$(CORPUS_INVITE_SECRET=smoke-only-not-a-secret corpus project create --name "Corpus (chrome)" | tail -1)"
export CORPUS_TOKEN
[ -n "$CORPUS_TOKEN" ] || { echo "no token from corpus project create" >&2; exit 1; }

echo "=== dogfood: push ==="
corpus push

echo "=== dogfood: pull at untranslated must reproduce the tree ==="
corpus pull --min-state untranslated
git diff --exit-code --stat -- apps/web/src/i18n || { echo "pull changed tracked files" >&2; exit 1; }
if [ -n "$(git status --porcelain --untracked-files=all -- apps/web/src/i18n)" ]; then
  echo "pull created files:" >&2; git status --porcelain -- apps/web/src/i18n >&2; exit 1
fi

echo "=== dogfood: pull at verified must write nothing ==="
corpus pull
git diff --exit-code --quiet -- apps/web/src/i18n
[ -z "$(git status --porcelain --untracked-files=all -- apps/web/src/i18n)" ]

echo "=== dogfood: PASS ==="
