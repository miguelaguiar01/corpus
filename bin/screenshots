#!/usr/bin/env bash
# README screenshots (spec §12): build once, then for each colour scheme
# start a fresh standalone server on a throwaway database and let
# apps/web/e2e/screenshots.ts stage the demo and capture the surfaces.
# Output: docs/screenshots/<surface>-<scheme>.png at 390px, 2x.
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${CORPUS_SMOKE_PORT:-3903}"
PID=""
TMP=""
cleanup() {
  if [ -n "$PID" ]; then kill "$PID" >/dev/null 2>&1 || true; fi
  if [ -n "$TMP" ]; then rm -rf "$TMP"; fi
  return 0
}
trap cleanup EXIT

if [ -z "${CORPUS_SMOKE_SKIP_BUILD:-}" ]; then
  echo "=== screenshots: build ==="
  npm run build -w apps/web
fi

for scheme in light dark; do
  cleanup; PID=""
  TMP="$(mktemp -d)"
  mkdir -p "$TMP/run" "$TMP/data"
  cp -r apps/web/.next/standalone/. "$TMP/run/"
  mkdir -p "$TMP/run/apps/web/.next"
  cp -r apps/web/.next/static "$TMP/run/apps/web/.next/static"
  echo "=== screenshots: $scheme ==="
  PORT="$PORT" HOSTNAME=127.0.0.1 NODE_ENV=production \
    CORPUS_DB_PATH="$TMP/data/corpus.db" \
    CORPUS_INVITE_SECRET=smoke-only-not-a-secret \
    node "$TMP/run/apps/web/server.js" >"$TMP/server.log" 2>&1 &
  PID=$!
  for _ in $(seq 1 60); do
    curl -sf "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1 && break
    sleep 1
  done
  curl -sf "http://127.0.0.1:$PORT/api/health" >/dev/null || { cat "$TMP/server.log" >&2; exit 1; }
  CORPUS_SMOKE_URL="http://127.0.0.1:$PORT" CORPUS_SMOKE_SECRET=smoke-only-not-a-secret \
    CORPUS_SHOT_SCHEME="$scheme" npx tsx apps/web/e2e/screenshots.ts
done
echo "=== screenshots: done ==="
