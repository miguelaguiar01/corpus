#!/usr/bin/env bash
# README screenshots (spec §12): build once, then for each viewport and
# colour scheme start a fresh standalone server on a throwaway database
# and let apps/web/e2e/screenshots.ts stage the demo and capture the
# surfaces. Output: docs/screenshots/<surface>[-desktop]-<scheme>.png at
# 390px or 1280px, 2x; the README references a subset, the rest is for
# PR evidence (CORPUS_SHOTS_DIR points the output elsewhere).
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${CORPUS_SMOKE_PORT:-3903}"
PID=""
TMP=""
cleanup() {
  if [ -n "$PID" ]; then kill "$PID" >/dev/null 2>&1 || true; fi
  if [ -n "$TMP" ]; then rm -rf "$TMP"; fi
  return 0
}
trap cleanup EXIT

if [ -z "${CORPUS_SMOKE_SKIP_BUILD:-}" ]; then
  echo "=== screenshots: build ==="
  npm run build -w apps/web
fi

for viewport in phone desktop; do
for scheme in light dark; do
  cleanup; PID=""
  TMP="$(mktemp -d)"
  mkdir -p "$TMP/run" "$TMP/data"
  cp -r apps/web/.next/standalone/. "$TMP/run/"
  mkdir -p "$TMP/run/apps/web/.next"
  cp -r apps/web/.next/static "$TMP/run/apps/web/.next/static"
  echo "=== screenshots: $viewport $scheme ==="
  # localhost throughout, never 127.0.0.1: Next names a loopback bind
  # localhost in the middleware URL, so a 127.0.0.1 origin gets an absolute
  # cross-origin redirect that a prefetch never settles; and a localhost
  # bind may listen on ::1 only, which a 127.0.0.1 health check misses.
  PORT="$PORT" HOSTNAME=localhost NODE_ENV=production \
    CORPUS_DB_PATH="$TMP/data/corpus.db" \
    CORPUS_INVITE_SECRET=smoke-only-not-a-secret \
    node "$TMP/run/apps/web/server.js" >"$TMP/server.log" 2>&1 &
  PID=$!
  for _ in $(seq 1 60); do
    curl -sf "http://localhost:$PORT/api/health" >/dev/null 2>&1 && break
    sleep 1
  done
  curl -sf "http://localhost:$PORT/api/health" >/dev/null || { cat "$TMP/server.log" >&2; exit 1; }
  CORPUS_SMOKE_URL="http://localhost:$PORT" CORPUS_SMOKE_SECRET=smoke-only-not-a-secret \
    CORPUS_SHOT_SCHEME="$scheme" CORPUS_SHOT_VIEWPORT="$viewport" npx tsx apps/web/e2e/screenshots.ts
done
done
echo "=== screenshots: done ==="
