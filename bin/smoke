#!/usr/bin/env bash
# The Playwright smoke (spec §15): build the app, start the standalone
# server on a throwaway database, run apps/web/e2e against it, tear down.
# CORPUS_SMOKE_SKIP_BUILD=1 reuses an existing build.
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${CORPUS_SMOKE_PORT:-3902}"
TMP="$(mktemp -d)"
PID=""
cleanup() {
  [ -n "$PID" ] && kill "$PID" >/dev/null 2>&1 || true
  rm -rf "$TMP"
}
trap cleanup EXIT

if [ -z "${CORPUS_SMOKE_SKIP_BUILD:-}" ]; then
  echo "=== smoke: build ==="
  npm run build -w apps/web
fi

echo "=== smoke: stage + start ==="
mkdir -p "$TMP/run" "$TMP/data"
cp -r apps/web/.next/standalone/. "$TMP/run/"
mkdir -p "$TMP/run/apps/web/.next"
cp -r apps/web/.next/static "$TMP/run/apps/web/.next/static"
# localhost throughout, never 127.0.0.1: Next names a loopback bind
# localhost in the middleware URL, so a 127.0.0.1 origin gets an absolute
# cross-origin redirect that a prefetch never settles; and a localhost
# bind may listen on ::1 only, which a 127.0.0.1 health check misses.
PORT="$PORT" HOSTNAME=localhost NODE_ENV=production \
  CORPUS_DB_PATH="$TMP/data/corpus.db" \
  CORPUS_INVITE_SECRET=smoke-only-not-a-secret \
  node "$TMP/run/apps/web/server.js" >"$TMP/server.log" 2>&1 &
PID=$!
for _ in $(seq 1 60); do
  curl -sf "http://localhost:$PORT/api/health" >/dev/null 2>&1 && break
  sleep 1
done
curl -sf "http://localhost:$PORT/api/health" >/dev/null || { cat "$TMP/server.log" >&2; exit 1; }

echo "=== smoke: playwright ==="
CORPUS_SMOKE_URL="http://localhost:$PORT" CORPUS_SMOKE_SECRET=smoke-only-not-a-secret \
  npx playwright test -c apps/web/playwright.config.ts "$@"
echo "=== smoke: PASS ==="
