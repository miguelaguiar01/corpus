#!/usr/bin/env bash
# bin/wiki-record — re-record the command output the wiki shows.
#
# The recordings under docs/wiki/recorded/ come from a real run in a
# temporary repository; packages/cli/src/wiki.test.ts fails when they
# and the CLI disagree. Run this when the CLI's output changes on
# purpose, then read the diff before committing it.
set -euo pipefail
cd "$(dirname "$0")/.."
WIKI_RECORD=1 npx vitest run packages/cli/src/wiki.test.ts
bin/wiki-check --fix
bin/wiki-check
