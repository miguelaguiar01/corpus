# Corpus web app environment (apps/web)

# Instance invite secret (§10): required. Anyone presenting it plus a
# display name gets a session; the first user ever created becomes a
# maintainer.
CORPUS_INVITE_SECRET=change-me

# Path of the SQLite database file. In the Docker deployment this points
# into the mounted volume. Default: ./data/corpus.db
CORPUS_DB_PATH=./data/corpus.db
